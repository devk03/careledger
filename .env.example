# Optional. Leave all keys blank for local record organization without AI.
# A caregiver supplies their own key; CareLedger never funds inference centrally.
APP_EDITION=community
AI_CREDENTIAL_MODE=self_hosted
AI_PROVIDER=auto
AI_MODEL=openai/gpt-5.4-mini
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Optional OpenAI Responses-compatible gateway. HTTPS is required unless local.
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=

# Optional host-facing Compose settings.
CARELEDGER_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
