# Local/self-hosted edition. Copy to .env on first setup only.
# Leave keys blank and AI_PROVIDER=auto to organize records without AI.
# For OpenRouter: AI_PROVIDER=openrouter and add OPENROUTER_API_KEY below.
# For OpenAI: AI_PROVIDER=openai, AI_MODEL=gpt-5.4-mini, and add OPENAI_API_KEY.
# Usage is charged to your own provider account. Never commit .env.
APP_EDITION=community
AI_CREDENTIAL_MODE=self_hosted
AI_PROVIDER=auto
AI_MODEL=openai/gpt-5.4-mini
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# Advanced: AI_PROVIDER=custom_responses and a compatible AI_MODEL are also required.
# Gateway must support the Responses API, file/image input and strict structured output.
# HTTPS is required unless local. Not all OpenAI-compatible chat gateways qualify.
CUSTOM_AI_API_KEY=
CUSTOM_AI_BASE_URL=

# Optional host-facing Compose settings.
CARELEDGER_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
