FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder
WORKDIR /build
RUN apk add --no-cache python3 make g++
COPY packages/contracts/package.json ./packages/contracts/
COPY server/package.json server/package-lock.json ./server/
COPY web/package.json web/package-lock.json ./web/
RUN cd server && npm ci --no-audit --no-fund
RUN cd web && npm ci --ignore-scripts --no-audit --no-fund
COPY packages/contracts/ ./packages/contracts/
COPY server/ ./server/
COPY web/ ./web/
RUN cd server && npm run build
RUN cd web && npm run build
RUN cd server && npm prune --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runtime
RUN addgroup -S -g 10001 adeno && adduser -S -u 10001 -G adeno adeno
WORKDIR /app
COPY --from=builder /build/server/package.json ./server/package.json
COPY --from=builder /build/server/node_modules ./server/node_modules
COPY --from=builder /build/server/dist ./server/dist
COPY --from=builder /build/packages/contracts ./packages/contracts
COPY --from=builder /build/web/dist ./web
ENV NODE_ENV=production ADENO_EDITION=trusted-private PORT=8080 \
    ADENO_PRIVATE_DB_PATH=/data/case.sqlite ADENO_PRIVATE_SECRETS_DIR=/data/secrets \
    ADENO_PRIVATE_WEB_ROOT=/app/web
USER adeno
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8080/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "server/dist/runPrivatePilot.js"]
