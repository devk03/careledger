# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS builder
WORKDIR /build
COPY packages/contracts/package.json packages/contracts/tsconfig.json ./packages/contracts/
COPY packages/contracts/src/ ./packages/contracts/src/
COPY server/package.json server/package-lock.json server/tsconfig.json server/tsconfig.build.json ./server/
WORKDIR /build/server
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY server/src/ ./src/
RUN npm run build

FROM node:22.23.2-bookworm-slim@sha256:48e4b67d85f87bd551df43704e24d252f56cc5f8e9718841aace50f19948f0f9 AS runtime
RUN groupadd --gid 10003 adeno-parser-socket \
    && useradd --uid 10002 --gid 10003 --no-create-home --home-dir /nonexistent adeno-parser \
    && install -d -o 10002 -g 10003 -m 0710 /run/adeno-parser
WORKDIR /app/server
COPY parser/package.json parser/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund
COPY --from=builder /build/server/dist/ ./dist/
RUN test "$(stat -c %u dist/runParserWorker.js)" -eq 0 \
    && test "$(stat -c %u node_modules/sharp/package.json)" -eq 0 \
    && node -e "import('sharp').then(s => { if (!s.default.versions.vips) process.exit(1) })"
ENV NODE_ENV=production \
    ADENO_PARSER_SOCKET_PATH=/run/adeno-parser/parser.sock
USER 10002:10003
CMD ["node", "dist/runParserWorker.js"]
