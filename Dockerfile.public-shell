# syntax=docker/dockerfile:1.7@sha256:a57df69d0ea827fb7266491f2813635de6f17269be881f696fbfdf2d83dda33e
FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS web-builder
WORKDIR /build
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY web/package.json web/package-lock.json ./web/
RUN cd web && npm ci --ignore-scripts --no-audit --no-fund
COPY web/tsconfig.app.json web/tsconfig.public-shell.json web/vite.public-shell.config.ts ./web/
COPY web/public-shell/ ./web/public-shell/
COPY web/src/tokens.css web/src/GitHubLink.tsx ./web/src/
COPY web/src/publicShell/ ./web/src/publicShell/
COPY web/public/images/notes-640.webp web/public/images/notes-1200.webp web/public/images/notes-1536.webp ./web/public/images/
RUN cd web && npm run build:public-shell

FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS server-builder
WORKDIR /build
COPY packages/contracts/package.json ./packages/contracts/package.json
COPY server/package.json server/package-lock.json ./server/
RUN apk add --no-cache python3 make g++ \
    && cd server && npm ci --ignore-scripts --no-audit --no-fund
COPY server/tsconfig.json server/tsconfig.public-shell.json ./server/
COPY server/src/publicShell.ts server/src/publicProjectStats.ts server/src/runPublicShell.ts ./server/src/
RUN cd server && npm run build:public-shell

FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runtime-deps
WORKDIR /app
COPY server/public-shell-runtime/package.json server/public-shell-runtime/package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts --no-audit --no-fund

FROM node:22.23.2-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runtime
RUN addgroup -S -g 10001 adeno && adduser -S -u 10001 -G adeno adeno
WORKDIR /app
COPY --from=runtime-deps /app/node_modules ./node_modules
COPY --from=server-builder /build/server/dist-public-shell ./dist
COPY --from=web-builder /build/web/dist-public-shell ./web
COPY server/public-shell-runtime/package.json ./package.json
ENV NODE_ENV=production \
    ADENO_SHELL_MODE=public-only \
    ADENO_SHELL_WEB_ROOT=/app/web \
    PORT=8080
USER adeno
EXPOSE 8080
HEALTHCHECK --interval=20s --timeout=3s --start-period=15s --retries=3 \
  CMD ["node", "-e", "fetch('http://127.0.0.1:8080/health/ready').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
CMD ["node", "dist/runPublicShell.js"]
