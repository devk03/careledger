#!/bin/sh
set -eu
# Called by the host's existing Certbot renewal service; no separate schedule.
if [ "${RENEWED_LINEAGE:-}" != "/etc/letsencrypt/live/adeno.kunjadia.dev" ]; then
    exit 0
fi
/usr/bin/timeout --signal=TERM --kill-after=5 60 /bin/sh -c '/usr/sbin/nginx -t && /bin/systemctl reload nginx'
